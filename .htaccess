# ============================================================================
# AL-RAHIM TEXTILE INDUSTRIES - .htaccess
# With HTTPS forced (uncomment rewrite lines if SSL is installed)
# ============================================================================

# ----------------------------------------------------------------------------
# Force HTTPS (Uncomment if SSL certificate is active)
# ----------------------------------------------------------------------------
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# ----------------------------------------------------------------------------
# Serve local HTTrack/Framer mirror folder while keeping preview.alviglobal.com in address bar
# This uses the LOCAL folder: energized-dragon-073129.framer.app/
# ----------------------------------------------------------------------------

# Homepage: internally serve the mirrored index.html without redirecting
RewriteRule ^$ energized-dragon-073129.framer.app/index.html [L]

# For assets/pages requested from the root URL, load them from the mirror folder
# only when they are not already real files/folders at the root.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/energized-dragon-073129.framer.app%{REQUEST_URI} -f [OR]
RewriteCond %{DOCUMENT_ROOT}/energized-dragon-073129.framer.app%{REQUEST_URI} -d
RewriteRule ^(.+)$ energized-dragon-073129.framer.app/$1 [L]

# ----------------------------------------------------------------------------
# Custom Error Pages
# ----------------------------------------------------------------------------
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
ErrorDocument 500 /404.html

# ----------------------------------------------------------------------------
# Gzip Compression
# ----------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
  AddOutputFilterByType DEFLATE application/x-javascript application/rss+xml image/svg+xml
  AddOutputFilterByType DEFLATE font/woff font/woff2
</IfModule>

# ----------------------------------------------------------------------------
# Browser Caching
# ----------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 week"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ----------------------------------------------------------------------------
# Security Headers
# ----------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-XSS-Protection "1; mode=block"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# ----------------------------------------------------------------------------
# Disable directory browsing
# ----------------------------------------------------------------------------
Options -Indexes

# ----------------------------------------------------------------------------
# Protect sensitive files
# ----------------------------------------------------------------------------
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>

# ----------------------------------------------------------------------------
# Remove trailing slashes (SEO)
# ----------------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [R=301,L]